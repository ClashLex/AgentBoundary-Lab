{
  "name": "unreliable-orchestra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "share": "node scripts/share.mjs",
    "lint": "eslint . --max-warnings 0",
